{
  "name": "claude-code-study",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Codeを基礎から上級まで学べる学習Webアプリ",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "verify": "node scripts/verify.mjs",
    "e2e": "pnpm --filter @claude-study/e2e run all",
    "e2e:a11y": "pnpm --filter @claude-study/e2e run a11y"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.84",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
